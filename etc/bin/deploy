#!/bin/sh
set -e

export WORKING_DIR=/opt/games/

echo "=== move to app dir ==="
cd ${WORKING_DIR}

echo "=== reading $(pwd)/.version file ==="
export $(grep -v '^#' .version | xargs)

echo "=== pulling image '${DOCKER_IMAGE}' ==="
docker pull ${DOCKER_IMAGE}

echo "=== restarting service ==="
sudo systemctl restart games.service

echo "=== clearing ==="
echo y | docker image prune -a

echo "=== check status ==="
echo "sleeping a while ... "
sleep 5
sudo systemctl show -p ActiveState --value games

echo "=== show containers ==="
sleep 15
docker ps --format "table {{.ID}}\t{{.Image}}\t{{.Names}}\t{{.Status}}\t|" | grep games
echo "==="
